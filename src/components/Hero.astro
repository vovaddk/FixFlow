---
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero-designer.png';

const lines = ['We customize your', 'Webflow template', 'in minutes'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <h1 id="hero-title" class="title">
      {lines.map((line, i) => (
        <span class="line" style={`--i: ${i}`}>
          <span>{line}</span>
        </span>
      ))}
    </h1>
    <figure class="frame">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        widths={[480, 800, 1066]}
        sizes="(min-width: 75rem) 1066px, 92vw"
        alt="The Webflow Designer open on a portfolio template, with the style and colour panels beside the canvas"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-l) var(--space-xl);
    text-align: center;
    background:
      radial-gradient(60% 45% at 50% 100%, var(--violet-tint), transparent 70%), var(--paper);
  }

  .title {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-block-end: 0.06em;
  }

  .line > span {
    display: inline-block;
    animation: rise 0.9s var(--ease-out) both;
    animation-delay: calc(var(--i) * 90ms);
  }

  .frame {
    max-inline-size: 66.625rem;
    margin: var(--space-l) auto 0;
    animation: lift 1.1s var(--ease-out) 0.3s both;
  }

  .frame :global(img) {
    inline-size: 100%;
    filter: drop-shadow(0 30px 50px rgb(60 30 120 / 0.18));
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes lift {
    from {
      opacity: 0;
      transform: translateY(2.5rem) scale(0.98);
    }
  }
</style>
