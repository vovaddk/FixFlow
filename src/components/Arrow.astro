---
interface Props {
  diagonal?: boolean;
}
const { diagonal = false } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  width="16"
  height="16"
  fill="none"
  aria-hidden="true"
  focusable="false"
  style={diagonal ? 'transform: rotate(-45deg)' : undefined}
>
  <path
    d="M2 8h11m-4-4.5L13.5 8 9 12.5"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
